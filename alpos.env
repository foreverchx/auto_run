# Loaded for oms / sys. Their main() copies these into system properties and fails on null.
# Replace with real AWS keys only if you need S3 / EDI features locally.
AWS_ACCESS_KEY_ID=local-unset
AWS_SECRET_ACCESS_KEY=local-unset
AWS_EDI_ACCESS_KEY_ID=local-unset
AWS_EDI_SECRET_ACCESS_KEY=local-unset
